{
  "name": "word-bibtex-citation-addin",
  "productName": "BibCite",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Cite from a BibTeX file in Microsoft Word. The .bib is read-only and stays your source of truth.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:docker": "VITE_SITE_URL=https://example.org/not-a-deployment npm run build && vite preview --host 0.0.0.0",
    "test": "node tests/run.mjs",
    "sync:bib-core": "node scripts/sync-bib-core.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "npm audit --audit-level=critical",
    "license:check": "node scripts/license-check.mjs",
    "secrets:scan": "node scripts/secrets-scan.mjs",
    "validate": "office-addin-manifest validate dist/manifest.xml",
    "verify": "docker compose run --rm verify",
    "verify:run": "npm run typecheck && npm run lint && npm run format:check && VITE_SITE_URL=${VITE_SITE_URL:-https://example.org/not-a-deployment} npm run build && npm test && npm run security:audit && npm run license:check && npm run secrets:scan"
  },
  "dependencies": {
    "bibliojson": "4.0.4",
    "citeproc": "2.4.63"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/office-js": "1.0.601",
    "acorn": "8.18.0",
    "esbuild": "0.28.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "office-addin-manifest": "2.1.6",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "fast-uri": "3.1.8"
  }
}
